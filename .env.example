GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# URL of the Cloudflare Worker that has the D1 binding.
CF_D1_WORKER_URL=
# Same random secret as the Worker's SERVICE_TOKEN secret.
CF_D1_SERVICE_TOKEN=

# Enable only after applying encryption-schema.sql and deploying the Worker.
GITIUM_E2EE_ENABLED=
