{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitium-data",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitium",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
